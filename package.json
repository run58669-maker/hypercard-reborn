{
  "name": "hypercard-reborn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HyperCard Reborn \u2014 compile once, run the stored script. Flip cards offline by default.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks",
    "build:chunks": "vite build --mode chunks --outDir dist-chunks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.14.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.72.1",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  }
}
